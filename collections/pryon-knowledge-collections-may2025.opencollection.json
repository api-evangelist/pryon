{
  "opencollection": "1.0.0",
  "info": {
    "name": "Knowledge Collection Service",
    "version": "1.0.0-alpha"
  },
  "items": [
    {
      "info": {
        "name": "List Knowledge Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Knowledge Collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/knowledge/v1alpha1/collections",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "query",
                "description": "Unique identifiers of the teams authorized to the knowledge collection."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Requested page size; default and maximum value are both 100."
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query",
                "description": "Returned for multiple pages; must be specified in each request for two pages per sheet using the page token parameter."
              },
              {
                "name": "solution_id",
                "value": "",
                "type": "query",
                "description": "Licensed solution for the collection; if not provided, the organizational default solution is automatically assigned."
              }
            ]
          },
          "docs": "List all knowledge collections configured for an organization."
        }
      ]
    },
    {
      "info": {
        "name": "KnowledgeCollectionService",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Knowledge Collections",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/knowledge/v1alpha1/collections",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Knowledge Collections"
        },
        {
          "info": {
            "name": "Delete Knowledge Collections",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/knowledge/v1alpha1/collections/:collection_id",
            "params": [
              {
                "name": "collection_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the knowledge collection."
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "Flag used to force delete a collection when it is set as an organizational or user default; default is false."
              }
            ]
          },
          "docs": "Delete collections from an organization while also locating and decommissioning all knowledge domain versions associated with the record."
        },
        {
          "info": {
            "name": "Get Knowledge Collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/knowledge/v1alpha1/collections/:collection_id/domains/:knowledge_domain_id",
            "params": [
              {
                "name": "collection_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the knowledge collection."
              },
              {
                "name": "knowledge_domain_id",
                "value": "",
                "type": "path",
                "description": "Unique ID of the knowledge domain."
              }
            ]
          },
          "docs": "Retrieve all knowledge collections for an organization."
        }
      ]
    },
    {
      "info": {
        "name": "Knowledge Collection Service",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Knowledge Collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/knowledge/v1alpha1/collections/:collection_id",
            "params": [
              {
                "name": "collection_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the knowledge collection."
              }
            ]
          },
          "docs": "Retrieve an existing knowledge collection."
        }
      ]
    }
  ],
  "bundled": true
}