{
  "opencollection": "1.0.0",
  "info": {
    "name": "pryon/api/ext/analytics/v1/analytics.proto Messages API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ListMessages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pryon.net/api/messages/v1/messages",
            "headers": [
              {
                "name": "Authentication",
                "value": "Authorization: Bearer {base64-encoded-token}"
              }
            ]
          },
          "docs": "List messages."
        },
        {
          "info": {
            "name": "GetMessage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pryon.net/api/messages/v1/messages/:message_id",
            "headers": [
              {
                "name": "Authentication",
                "value": "Authorization: Bearer {base64-encoded-token}"
              }
            ],
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a message."
        },
        {
          "info": {
            "name": "DeleteMessage",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pryon.net/api/messages/v1/messages/:message_id",
            "headers": [
              {
                "name": "Authentication",
                "value": "Authorization: Bearer {base64-encoded-token}"
              }
            ],
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path",
                "description": "The id of the message to delete."
              }
            ]
          },
          "docs": "Delete a message."
        },
        {
          "info": {
            "name": "ListSystemEvents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pryon.net/api/messages/v1/system-events",
            "headers": [
              {
                "name": "Authentication",
                "value": "Authorization: Bearer {base64-encoded-token}"
              }
            ]
          },
          "docs": "ListSystemEvents returns all system events for the user's organization."
        }
      ]
    }
  ],
  "bundled": true
}