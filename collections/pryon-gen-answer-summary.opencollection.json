        {
          "info": {
            "name": "Generative_CreateChatCompletions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{pryon_base_url}/api/generative/v1alpha1/chat/completions",
            "headers": [
              {
                "name": "Authorization",
                "value": "Authorization: Bearer {base64-encoded-token}"
              },
              {
                "name": "x-pryon-org-id",
                "value": "pryoninc.com"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "A generic text-generation interface to external LLM providers and Pryon-hosted LLMs.\n implements a subset of the OpenAI /v1/chat/completions API specification\n as defined here: https://platform.openai.com/docs/api-reference/chat\n Using the official OpenAI client SDK for your language is recommended.\n The following providers are supported currently:\n - pryon\n - openai\n - anthropic\n - vertex ai\n Please check the respective provider's documentation\n for supported text-generation models and accepted"
        },
        {
          "info": {
            "name": "Generative_ListChatCompletionsModels",
            "type": "http"
          },
